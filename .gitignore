# Dependencies
node_modules/
# package-lock.json is committed on purpose: ignoring it made every install
# resolve express/ws to whatever was newest that day, so two machines running
# the same commit could get different dependency trees.

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Test / scratch
scratch/
test-output/
coverage/
.nyc_output/

